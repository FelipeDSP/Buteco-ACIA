# Supabase — projeto Boteco ACIA
# A URL e a chave publicavel vao para o navegador de proposito: sao publicas e
# a leitura das casas e protegida por RLS (policy: ativa = true).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. Ignora RLS por completo.
# NUNCA prefixar com NEXT_PUBLIC_ e nunca importar em componente de cliente.
# Usada so em route handler, para criar sessao e gravar avaliacao.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do HMAC do CPF. Sem ele o CPF cairia por forca bruta: sao 11 digitos
# e o espaco inteiro se calcula em minutos num notebook.
# TROCAR ESTE VALOR INVALIDA TODOS OS HASHES JA GRAVADOS.
CPF_PEPPER=

# Opcional: finge que hoje e outra data, para conferir o site em outra fase.
# BOTECO_FASE_HOJE=2026-09-25

# Senha unica do painel administrativo (/painel). Sem contas: quem tem a senha
# entra. Trocar aqui desloga todo mundo na hora, porque o cookie e derivado
# dela. Gere com: node -e "console.log(require('crypto').randomBytes(21).toString('base64url'))"
PAINEL_SENHA=

# Limiares de anomalia da auditoria. Ajustaveis sem novo deploy: o numero certo
# so aparece com o festival rodando. Todos opcionais — sem eles valem os
# padroes entre parenteses.
# PAINEL_LIMIAR_IP_POR_CASA=15   # avaliacoes do mesmo IP na mesma casa
# PAINEL_LIMIAR_IP_EM_CASAS=5    # casas diferentes avaliadas pelo mesmo IP
# PAINEL_LIMIAR_RAJADA=8         # avaliacoes na mesma casa dentro da janela
# PAINEL_JANELA_RAJADA_MIN=5     # tamanho da janela, em minutos
# PAINEL_LIMIAR_COMENTARIO_IGUAL=3 # mesmo texto de observacao na mesma casa

# Datas do festival. Art. 30 do regulamento: a ACIA pode remarcar com 15 dias de
# aviso, e remarcacao nao pode depender de deploy. Sem estas variaveis valem as
# datas aprovadas em assembleia (entre parenteses). Formato AAAA-MM-DD; valor
# invalido e ignorado com aviso no log.
# BOTECO_INICIO_FESTIVAL=2026-09-19
# BOTECO_FIM_FESTIVAL=2026-10-10
# BOTECO_INICIO_APURACAO=2026-10-11
# BOTECO_FIM_APURACAO=2026-10-13
# BOTECO_DIVULGACAO=2026-10-14   # dia em que a aba Vencedores entra no menu

# Endereco publico do site, com esquema. Usado para montar a previa de
# compartilhamento (WhatsApp, Instagram) e qualquer URL absoluta.
# Runtime: trocar o dominio nao exige rebuild.
BOTECO_SITE_URL=https://boteco.aciaariquemes.com.br

