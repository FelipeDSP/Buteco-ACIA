# Supabase — projeto Boteco ACIA
# A URL e a chave publicavel vao para o navegador de proposito: sao publicas e
# a leitura das casas e protegida por RLS (policy: ativa = true).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role. Ignora RLS por completo.
# NUNCA prefixar com NEXT_PUBLIC_ e nunca importar em componente de cliente.
# Usada so em route handler, para criar sessao e gravar avaliacao.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do HMAC do CPF. Sem ele o CPF cairia por forca bruta: sao 11 digitos
# e o espaco inteiro se calcula em minutos num notebook.
# TROCAR ESTE VALOR INVALIDA TODOS OS HASHES JA GRAVADOS.
CPF_PEPPER=

# Opcional: finge que hoje e outra data, para conferir o site em outra fase.
# BOTECO_FASE_HOJE=2026-09-25
